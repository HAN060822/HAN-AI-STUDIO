# Copy to .env.local. Never put secrets in VITE_* variables.
HAN_AI_STUDIO_DATA_DIR=./var
HAN_AI_STUDIO_HOST=127.0.0.1
HAN_AI_STUDIO_PORT=5173
HAN_AI_STUDIO_PROVIDER_MODE=mock
# Absolute existing vault root containing .obsidian; unset disables external Knowledge saves.
# Prefer forward slashes in Windows paths. No vault is selected automatically.
HAN_AI_STUDIO_OBSIDIAN_VAULT=
# review (default) permits only explicitly reviewed local-owner publication; deny blocks it.
# Any unrecognized value fails closed to deny. Restart after changing governance policy.
HAN_AI_STUDIO_KNOWLEDGE_PUBLICATION=review
# Optional future server-only SecretRef mappings; none enables provider connectivity or permission.
HAN_AI_STUDIO_SECRET_OPENAI=
HAN_AI_STUDIO_SECRET_GEMINI=
HAN_AI_STUDIO_SECRET_GITHUB=
HAN_AI_STUDIO_SECRET_ENGINE=
VITE_APP_NAME=HAN's AI STUDIO
